rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is user authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: Get user data
    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check role
    function hasRole(role) {
      return isAuth() && getUser().role == role;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Papers
    match /papers/{paperId} {
      allow read: if isAuth();
      allow create: if hasRole('teacher') || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // Stories
    match /stories/{storyId} {
      allow read: if isAuth();
      allow create, update: if hasRole('teacher') || hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // Attempts
    match /attempts/{attemptId} {
      allow read: if isAuth() && request.auth.uid == resource.data.userId;
      allow create: if isAuth() && request.auth.uid == request.resource.data.userId;
    }
  }
}
